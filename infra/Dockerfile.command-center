FROM node:26-alpine AS builder
WORKDIR /workspace
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/command-center ./apps/command-center
COPY packages/shared-types ./packages/shared-types
RUN corepack enable && pnpm install --frozen-lockfile=false && pnpm --filter @aegiscudo/command-center build

FROM node:26-alpine AS runner
ARG APP_VERSION=0.1.0
ENV NEXT_PUBLIC_APP_VERSION=${APP_VERSION} NODE_ENV=production
WORKDIR /app
COPY --from=builder /workspace/apps/command-center/.next/standalone ./
COPY --from=builder /workspace/apps/command-center/.next/static ./apps/command-center/.next/static
COPY --from=builder /workspace/apps/command-center/public ./apps/command-center/public
USER node
CMD ["node", "apps/command-center/server.js"]