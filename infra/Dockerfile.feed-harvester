FROM rust:1-slim-bookworm AS builder
WORKDIR /workspace
COPY . .
RUN cargo build --release -p feed-harvester

FROM gcr.io/distroless/cc-debian12
ARG APP_VERSION=0.1.0
ENV APP_VERSION=${APP_VERSION}
COPY --from=builder /workspace/target/release/feed-harvester /usr/local/bin/feed-harvester
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/feed-harvester"]
