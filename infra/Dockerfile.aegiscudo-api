FROM rust:1-slim-bookworm AS builder
WORKDIR /workspace
COPY . .
RUN cargo build --release -p aegiscudo-api

FROM gcr.io/distroless/cc-debian12
ARG APP_VERSION=0.1.0
ENV APP_VERSION=${APP_VERSION}
COPY --from=builder /workspace/target/release/aegiscudo-api /usr/local/bin/aegiscudo-api
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/aegiscudo-api"]