FROM python:3.12-slim AS runner
ARG APP_VERSION=0.1.0
ENV APP_VERSION=${APP_VERSION} PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml uv.lock* ./
COPY services/emergency-room ./services/emergency-room
RUN pip install --no-cache-dir uv && uv pip install --system -e services/emergency-room fastapi orjson pydantic structlog uvicorn[standard]
USER 65532:65532
CMD ["uvicorn", "emergency_room.app:app", "--host", "0.0.0.0", "--port", "8080"]