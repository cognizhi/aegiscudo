# ---- builder stage: install dependencies into an isolated venv ----
FROM python:3.14-slim AS builder
WORKDIR /build
COPY pyproject.toml uv.lock* ./
COPY services/ai-analyst ./services/ai-analyst
COPY services/python-common ./services/python-common
RUN pip install --no-cache-dir uv \
 && uv venv /venv \
 && uv pip install --python /venv/bin/python \
        -e services/ai-analyst \
        fastapi orjson pydantic structlog langfuse "uvicorn[standard]"

# ---- runner stage: copy only the venv and application source ----
FROM python:3.14-slim AS runner
ARG APP_VERSION=0.1.0
ENV APP_VERSION=${APP_VERSION} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/venv/bin:$PATH" \
    VIRTUAL_ENV=/venv
WORKDIR /app
COPY --from=builder /venv /venv
COPY --from=builder /build/services/ai-analyst ./services/ai-analyst
USER 65532:65532
CMD ["uvicorn", "ai_analyst.app:app", "--host", "0.0.0.0", "--port", "8080"]