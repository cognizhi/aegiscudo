FROM rust:1-slim-bookworm AS builder
WORKDIR /workspace
COPY . .
RUN cargo build --release -p mosquito-net

FROM gcr.io/distroless/cc-debian12
ARG APP_VERSION=0.1.0
ENV APP_VERSION=${APP_VERSION}
COPY --from=builder /workspace/target/release/mosquito-net /usr/local/bin/mosquito-net
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/mosquito-net"]