{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aegiscudo.local/attestation-evidence.schema.json",
  "title": "AegiscudoAttestationEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["coordinate", "artifact_digest", "attestation_type", "predicate_type", "issuer", "subject_digest", "result", "verified_at", "verifier_version", "raw_document_digest"],
  "allOf": [
    {
      "if": { "required": ["result"], "properties": { "result": { "not": { "const": "pass" } } } },
      "then": {
        "not": {
          "anyOf": [
            { "properties": { "slsa_verified_levels": true }, "required": ["slsa_verified_levels"] },
            { "properties": { "slsa_build_level": true }, "required": ["slsa_build_level"] },
            { "properties": { "slsa_version": true }, "required": ["slsa_version"] },
            { "properties": { "vsa_verifier_id": true }, "required": ["vsa_verifier_id"] },
            { "properties": { "vsa_resource_uri": true }, "required": ["vsa_resource_uri"] },
            { "properties": { "vsa_policy_uri": true }, "required": ["vsa_policy_uri"] },
            { "properties": { "vsa_dependency_levels": true }, "required": ["vsa_dependency_levels"] }
          ]
        }
      }
    },
    {
      "if": { "required": ["slsa_build_level"], "properties": { "slsa_build_level": { "const": 0 } } },
      "then": {
        "properties": {
          "slsa_verified_levels": {
            "type": "array",
            "contains": { "const": "SLSA_BUILD_LEVEL_0" },
            "not": {
              "contains": { "enum": ["SLSA_BUILD_LEVEL_1", "SLSA_BUILD_LEVEL_2", "SLSA_BUILD_LEVEL_3"] }
            }
          }
        },
        "required": ["slsa_verified_levels"]
      }
    },
    {
      "if": { "required": ["slsa_build_level"], "properties": { "slsa_build_level": { "const": 1 } } },
      "then": {
        "properties": {
          "slsa_verified_levels": {
            "type": "array",
            "contains": { "const": "SLSA_BUILD_LEVEL_1" },
            "not": { "contains": { "enum": ["SLSA_BUILD_LEVEL_2", "SLSA_BUILD_LEVEL_3"] } }
          }
        },
        "required": ["slsa_verified_levels"]
      }
    },
    {
      "if": { "required": ["slsa_build_level"], "properties": { "slsa_build_level": { "const": 2 } } },
      "then": {
        "properties": {
          "slsa_verified_levels": {
            "type": "array",
            "contains": { "const": "SLSA_BUILD_LEVEL_2" },
            "not": { "contains": { "const": "SLSA_BUILD_LEVEL_3" } }
          }
        },
        "required": ["slsa_verified_levels"]
      }
    },
    {
      "if": { "required": ["slsa_build_level"], "properties": { "slsa_build_level": { "const": 3 } } },
      "then": {
        "properties": { "slsa_verified_levels": { "type": "array", "contains": { "const": "SLSA_BUILD_LEVEL_3" } } },
        "required": ["slsa_verified_levels"]
      }
    },
    {
      "if": {
        "anyOf": [
          { "properties": { "vsa_verifier_id": true }, "required": ["vsa_verifier_id"] },
          { "properties": { "vsa_resource_uri": true }, "required": ["vsa_resource_uri"] },
          { "properties": { "vsa_policy_uri": true }, "required": ["vsa_policy_uri"] },
          { "properties": { "vsa_dependency_levels": true }, "required": ["vsa_dependency_levels"] }
        ]
      },
      "then": { "properties": { "predicate_type": { "const": "https://slsa.dev/verification_summary/v1" } } }
    }
  ],
  "properties": {
    "coordinate": { "$ref": "#/$defs/packageCoordinate" },
    "artifact_digest": { "$ref": "#/$defs/digest" },
    "attestation_type": { "type": "string", "minLength": 1 },
    "predicate_type": { "type": "string", "minLength": 1 },
    "issuer": { "type": "string" },
    "subject_digest": { "$ref": "#/$defs/digest" },
    "result": { "enum": ["pass", "fail", "missing", "unverifiable"] },
    "verified_at": { "type": "string", "format": "date-time" },
    "verifier_version": { "type": "string", "minLength": 1 },
    "raw_document_digest": { "$ref": "#/$defs/digest" },
    "slsa_verified_levels": {
      "type": "array",
      "items": { "$ref": "#/$defs/slsaResult" }
    },
    "slsa_build_level": { "type": "integer", "minimum": 0, "maximum": 3 },
    "slsa_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "vsa_verifier_id": { "type": "string", "minLength": 1 },
    "vsa_resource_uri": { "type": "string", "minLength": 1 },
    "vsa_policy_uri": { "type": "string", "minLength": 1 },
    "vsa_dependency_levels": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/slsaResult" },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  },
  "$defs": {
    "slsaResult": {
      "type": "string",
      "pattern": "^(SLSA_[A-Z_]+_LEVEL_(UNEVALUATED|[0-9]+)|FAILED)$"
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "hex"],
      "properties": { "algorithm": { "const": "sha256" }, "hex": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    },
    "packageCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "name"],
      "properties": {
        "ecosystem": { "enum": ["npm", "pypi", "cargo", "maven", "docker-oci", "generic-http", "githubactions", "vscode-extension"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 }
      }
    }
  }
}