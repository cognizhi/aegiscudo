{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aegiscudo.local/webhook-endpoint.schema.json",
  "title": "AegiscudoWebhookEndpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "tenant_id",
    "display_name",
    "destination_type",
    "endpoint_url_ref",
    "destination_host",
    "enabled",
    "event_types",
    "payload_version",
    "signing_algorithm",
    "signing_secret_ref",
    "region",
    "retry_policy",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "schema_version": { "type": "string", "const": "webhook-endpoint/v1" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "destination_type": { "type": "string", "enum": ["slack", "pagerduty", "jira", "generic"] },
    "endpoint_url_ref": { "type": "string", "format": "uuid" },
    "destination_host": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?=.{1,253}$)([A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}$"
    },
    "enabled": { "type": "boolean" },
    "event_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "override.requested",
          "override.approved",
          "override.revoked",
          "override.expired",
          "critical_detection.created",
          "policy_violation.detected"
        ]
      }
    },
    "payload_version": { "type": "string", "const": "webhook-event/v1" },
    "signing_algorithm": { "type": "string", "const": "hmac-sha256" },
    "signing_secret_ref": { "type": "string", "format": "uuid" },
    "auth_credential_ref": { "type": "string", "format": "uuid" },
    "region": { "type": "string", "minLength": 2, "maxLength": 64 },
    "expires_at": { "type": "string", "format": "date-time" },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "initial_backoff_seconds", "max_backoff_seconds"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "initial_backoff_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "max_backoff_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "created_by": { "type": "string", "minLength": 1, "maxLength": 160 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}