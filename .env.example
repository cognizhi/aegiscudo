# Aegiscudo local bootstrap configuration. Copy to .env for local use only.
# Do not commit real credentials. Production deployments must use a secrets manager.

# GitHub Advisory Feed and GitHub-hosted threat intelligence.
# GitHub PAT with read-only package/advisory access, or a GitHub App installation token.
GITHUB_TOKEN=

# npm Registry. Optional unless proxying private npm registries.
NPM_REGISTRY_TOKEN=

# AI Providers. Configure credentials here before running ai-analyst jobs.
# The active provider and model selection come from the ai_provider_configs table,
# not from these environment variable names directly.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
OPENROUTER_API_KEY=

# Local LLM providers. Optional for Ollama, LM Studio, vLLM, or OpenAI-compatible hosts.
# LOCAL_LLM_BASE_URL is a bootstrap/network boundary setting; the chosen model still comes
# from the active ai_provider_configs row for the tenant.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=

# Langfuse prompt and LLM observability.
AEGISCUDO_LANGFUSE_PORT=13001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:13001

# Database and cache.
AEGISCUDO_POSTGRES_PORT=15432
LANGFUSE_POSTGRES_PORT=15433
AEGISCUDO_REDIS_PORT=16379
DATABASE_URL=postgres://aegiscudo:aegiscudo@localhost:15432/aegiscudo
LANGFUSE_DATABASE_URL=postgres://langfuse:langfuse@localhost:15433/langfuse
REDIS_URL=redis://localhost:16379

# Object storage. Local compose uses MinIO-compatible S3.
AEGISCUDO_MINIO_API_PORT=19000
AEGISCUDO_MINIO_CONSOLE_PORT=19001
GCS_BUCKET_ARTIFACTS=aegiscudo-artifacts-local
GCS_BUCKET_REPORTS=aegiscudo-reports-local
S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY_ID=aegiscudo
S3_SECRET_ACCESS_KEY=aegiscudo-local-only

# Aegiscudo Platform.
AEGISCUDO_ENV=development
AEGISCUDO_LOG_LEVEL=info
AEGISCUDO_OTEL_GRPC_PORT=14317
AEGISCUDO_OTEL_HTTP_PORT=14318
AEGISCUDO_TELEMETRY_ENDPOINT=http://localhost:14317
AEGISCUDO_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
AEGISCUDO_FAIL_CLOSED=true

# Mosquito Net. Use a long, deployment-specific secret so signed Cargo download routes
# stay valid across proxy restarts without becoming forgeable.
MOSQUITO_NET_CARGO_DOWNLOAD_MAC_KEY=replace-with-a-long-random-secret